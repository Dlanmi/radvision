---
interface Crumb {
  href?: string;
  label: string;
}
interface Props {
  crumbs?: Crumb[];
  kicker?: string;
  class?: string;
}
const { crumbs = [], kicker, class: cls = '' } = Astro.props;
---

<header class:list={['wrap pt-8 pb-12 md:pt-12 md:pb-16', cls]}>
  {
    crumbs.length > 0 && (
      <nav aria-label="Ruta" class="label mb-10 text-ink-3 md:mb-14">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li>
            <a href="/" class="link">
              Inicio
            </a>
          </li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {c.href ? (
                <a href={c.href} class="link">
                  {c.label}
                </a>
              ) : (
                <span class="text-ink" aria-current="page">
                  {c.label}
                </span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )
  }
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <div class:list={[Astro.slots.has('aside') ? 'lg:col-span-8' : 'lg:col-span-10']}>
      {kicker && <p class="label mb-6 text-ink-3">{kicker}</p>}
      <h1 class="display text-[clamp(2.4rem,1.3rem+3.6vw,4.6rem)]" data-split data-now>
        <slot />
      </h1>
      {
        Astro.slots.has('lead') && (
          <div class="mt-8 max-w-[58ch] text-[1.125rem] text-ink-2 md:text-[1.25rem] md:leading-[1.5]" data-reveal="up" data-delay="0.25">
            <slot name="lead" />
          </div>
        )
      }
      <slot name="after" />
    </div>
    {
      Astro.slots.has('aside') && (
        <div class="lg:col-span-4" data-reveal="up" data-delay="0.15">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</header>
