---
import { proyecto } from '../data/proyecto';
import { fabricantes, modalidades } from '../data';
import { nav } from '../data/nav';
import SenaLogo from './SenaLogo.astro';
---

<footer class="mt-auto bg-film text-film-ink">
  <div class="wrap pt-16 pb-10 md:pt-24">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-4">
          <SenaLogo size={56} variante="blanco" class="size-14 shrink-0" />
          <p class="label text-film-ink-2">Proyecto formativo<br />Servicio Nacional de Aprendizaje</p>
        </div>
        <p class="display mt-8 text-[clamp(1.9rem,1.3rem+2vw,3rem)]">
          Inteligencia artificial<br /><em>en imagen diagnóstica</em>
        </p>
        <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-[0.9375rem]">
          <dt class="label pt-1 text-film-ink-2">Entidad</dt>
          <dd>{proyecto.entidad}</dd>
          <dt class="label pt-1 text-film-ink-2">Centro</dt>
          <dd>{proyecto.centro} · {proyecto.regional}</dd>
          <dt class="label pt-1 text-film-ink-2">Programa</dt>
          <dd>{proyecto.programa} ({proyecto.codigoPrograma})</dd>
          <dt class="label pt-1 text-film-ink-2">Ficha</dt>
          <dd class="tnum">{proyecto.ficha}</dd>
          <dt class="label pt-1 text-film-ink-2">Instructor</dt>
          <dd>{proyecto.instructor}</dd>
          {
            proyecto.aprendices.length > 0 && (
              <>
                <dt class="label pt-1 text-film-ink-2">Aprendices</dt>
                <dd>{proyecto.aprendices.join(' · ')}</dd>
              </>
            )
          }
        </dl>
      </div>

      <nav class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-6 md:col-start-7" aria-label="Pie de página">
        <div>
          <p class="label text-film-ink-2">Secciones</p>
          <ul class="mt-4 space-y-2">
            {nav.map((n) => <li><a class="link" href={n.href}>{n.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label text-film-ink-2">Modalidades</p>
          <ul class="mt-4 space-y-2">
            {
              modalidades.map((m) => (
                <li>
                  <a class="link" href={`/modalidades/${m.id}/`}>
                    {m.corto}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="label text-film-ink-2">Fabricantes</p>
          <ul class="mt-4 space-y-2">
            {
              fabricantes.map((f) => (
                <li>
                  <a class="link" href={`/fabricantes/${f.id}/`}>
                    {f.corto}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-film-line pt-6 text-[0.8125rem] text-film-ink-2 md:flex-row md:justify-between">
      <p class="max-w-[70ch]">
        Contenido académico basado en el documento «{proyecto.documento}». No constituye recomendación
        clínica ni comercial. Los nombres de productos y marcas pertenecen a sus respectivos titulares.
      </p>
      <p class="label shrink-0">SENA · {proyecto.anio}</p>
    </div>
  </div>
</footer>
