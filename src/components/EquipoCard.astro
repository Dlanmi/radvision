---
import type { Equipo } from '../data/types';
import { fabricantePorId, modalidadPorId, productosDe } from '../data';
import Cifras from './Cifras.astro';
import Schematic from './Schematic.astro';
import { Image } from 'astro:assets';
import { fotosDe } from '../data/fotos';

interface Props {
  e: Equipo;
  /** Qué se muestra arriba: el fabricante (vista por modalidad) o la modalidad (vista por fabricante). */
  top?: 'fabricante' | 'modalidad';
  n?: string;
}
const { e, top = 'fabricante', n } = Astro.props;
const f = fabricantePorId[e.fabricante];
const m = modalidadPorId[e.modalidad];
const productos = productosDe(e);
const foto = fotosDe(e.slug)[0];
---

<a href={`/equipos/${e.slug}/`} class="card flex h-full flex-col bg-bg p-5 md:p-6">
  <span class="label flex items-center justify-between gap-3 text-ink-3">
    <span class="flex items-center gap-2">
      {n && <span class="tnum">{n}</span>}
      {top === 'fabricante' ? <span class="text-ink">{f.corto}</span> : <span class="text-ink">{m.codigo} · {m.corto}</span>}
    </span>
    <span class="go" aria-hidden="true">→</span>
  </span>
  <span class:list={['thumb mt-5', foto?.captura && 'captura', !foto && 'sin-foto']}>
    {
      foto ? (
        <Image src={foto.img} alt={foto.alt} widths={[360, 560, 800]} sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw" class="thumb-img" />
      ) : (
        <Schematic id={e.modalidad} annotate={false} />
      )
    }
  </span>
  <span class="mt-6 block font-display text-[1.375rem] font-semibold leading-[1.12]">
    {
      productos.map((p, i) => (
        <span class="block">
          {i > 0 && <span class="text-ink-3">/ </span>}
          {p.nombre}
          {p.nota && <span class="block font-sans text-[0.8125rem] leading-snug text-ink-3">{p.nota}</span>}
        </span>
      ))
    }
  </span>
  <span class="mt-2 block text-[0.9375rem] text-ink-2">{e.descriptor}</span>
  <span class="mt-5 flex flex-wrap gap-1.5">
    {e.algoritmos.slice(0, 3).map((a) => <span class="tag">{a}</span>)}
    {e.algoritmos.length > 3 && <span class="tag text-ink-3">+{e.algoritmos.length - 3}</span>}
  </span>
  <Cifras cifras={e.cifras.slice(0, 2)} class="mt-auto pt-8" />
</a>

<style>
  .thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    background: var(--c-plate);
    border: 1px solid var(--c-line);
    overflow: hidden;
  }
  .thumb :global(.thumb-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 6%;
    mix-blend-mode: multiply;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb.captura {
    background: #0d0f0e;
  }
  .thumb.captura :global(.thumb-img) {
    padding: 0;
    object-fit: cover;
    mix-blend-mode: normal;
  }
  .thumb.sin-foto {
    background: transparent;
    padding: 10% 16%;
    color: var(--c-ink-3);
  }
  @media (hover: hover) {
    .card:hover .thumb :global(.thumb-img) {
      transform: scale(1.04);
    }
  }
  .card {
    transition: background-color 0.25s;
  }
  .go {
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (hover: hover) {
    .card:hover {
      background: var(--c-bg-2);
    }
    .card:hover .go {
      transform: translateX(5px);
      color: var(--c-ink);
    }
  }
</style>
