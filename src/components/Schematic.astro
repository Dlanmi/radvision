---
import type { ModalidadId } from '../data/types';

interface Props {
  id: ModalidadId;
  class?: string;
  /** Muestra cotas y rótulos técnicos. */
  annotate?: boolean;
  title?: string;
  /** Giro continuo del gantry y haz en movimiento (desactivar si otra animación lo controla). */
  live?: boolean;
  /** Trazar las líneas al entrar en pantalla. */
  draw?: boolean;
}

const { id, class: cls = '', annotate = true, title, live = true, draw = false } = Astro.props;

// Ticks del anillo giratorio de TAC / PET (24 marcas).
const ticks = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  const r1 = 60;
  const r2 = i % 6 === 0 ? 67 : 64;
  return {
    x1: 120 + r1 * Math.cos(a),
    y1: 90 + r1 * Math.sin(a),
    x2: 120 + r2 * Math.cos(a),
    y2: 90 + r2 * Math.sin(a),
  };
});

// Bloques detectores del anillo PET.
const bloques = Array.from({ length: 28 }, (_, i) => (i / 28) * 360);
---

<svg
  viewBox="0 0 240 180"
  class:list={['schematic', live && 'live', cls]}
  data-draw={draw ? '' : undefined}
  fill="none"
  stroke="currentColor"
  stroke-width="1.15"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  data-schematic={id}
>
  {title && <title>{title}</title>}

  {
    id === 'rx' && (
      <g>
        <path d="M14 14H226" class="thin" />
        <rect x="96" y="14" width="48" height="9" />
        <rect x="114" y="23" width="12" height="35" />
        <rect x="94" y="58" width="52" height="16" rx="2" />
        <path d="M108 74H132L128 84H112Z" />
        <path class="beam" d="M112 84L90 127M128 84L150 127" />
        <path class="beam axis" d="M120 84V127" />
        <path d="M64 127q8-9 22-9h46q16 0 26 9" class="thin" />
        <rect x="46" y="127" width="148" height="6" />
        <path d="M66 133V162M174 133V162M14 162H226" />
        <rect x="206" y="38" width="9" height="124" />
        <rect x="197" y="70" width="9" height="40" />
        {annotate && (
          <g class="dim">
            <path d="M34 74V127M30 74H38M30 127H38" />
            <text x="22" y="104">
              SID
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'fluoro' && (
      <g>
        <path d="M14 162H226" />
        <rect x="102" y="128" width="36" height="34" />
        <g transform="rotate(-16 120 120)">
          <rect x="34" y="113" width="172" height="9" />
          <rect x="104" y="58" width="32" height="22" rx="2" />
          <path d="M116 80V113M124 80V113" class="thin" />
          <path d="M112 58h16v-6h-16z" />
          <path class="beam" d="M112 124L108 80M128 124L132 80" />
        </g>
        <circle cx="120" cy="120" r="3" />
        {annotate && (
          <g class="dim">
            <path d="M33.5 88.5A92 92 0 0 0 33.5 151.5" stroke-dasharray="2 3" />
            <path d="M30 92l3.5-3.5 4.5 1.5M30 148l3.5 3.5 4.5-1.5" />
            <text x="8" y="124">
              ±90°
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'arco-c' && (
      <g>
        <path d="M141 36.3A62 62 0 1 0 141 143.7L137 136.8A54 54 0 1 1 137 43.2Z" />
        <rect x="126" y="22" width="30" height="10" rx="1" />
        <rect x="130" y="144" width="22" height="14" rx="2" />
        <path class="beam" d="M137 144L129 32M145 144L153 32" />
        <rect x="92" y="87" width="140" height="5" />
        <path d="M48 86H22V96H48" />
        <rect x="12" y="96" width="14" height="44" />
        <rect x="6" y="140" width="74" height="12" rx="1" />
        <circle cx="18" cy="158" r="5" />
        <circle cx="68" cy="158" r="5" />
        <path d="M176 92V160M216 92V160M160 162H232" class="thin" />
        {annotate && (
          <g class="dim">
            <path d="M110 90m-74 0a74 74 0 0 1 36-63.5" stroke-dasharray="2 3" />
            <text x="40" y="34">
              ORBITAL
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'tac' && (
      <g>
        <rect x="46" y="14" width="148" height="148" rx="20" />
        <circle cx="120" cy="90" r="38" />
        <circle cx="120" cy="90" r="54" class="thin" stroke-dasharray="1.5 3" />
        <g class="spin">
          {ticks.map((t) => (
            <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="thin" />
          ))}
          <rect x="111" y="30" width="18" height="10" rx="1.5" />
          <path d="M147 136.8A54 54 0 0 1 93 136.8" stroke-width="3.5" />
          <path class="beam" d="M117 40L95 134M123 40L145 134" />
        </g>
        <rect x="94" y="104" width="52" height="6" rx="1" />
        <path d="M60 162V168H180V162M10 168H230" />
        {annotate && (
          <g class="dim">
            <path d="M206 52V128M202 52H210M202 128H210" />
            <text x="194" y="44">
              GANTRY
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'rm' && (
      <g>
        <rect x="30" y="20" width="160" height="134" rx="26" />
        <rect x="38" y="28" width="144" height="118" rx="20" class="thin" />
        <circle cx="110" cy="87" r="46" />
        <circle cx="110" cy="87" r="40" class="thin" />
        <rect x="58" y="113" width="180" height="7" />
        <path d="M200 120V162H232V120M14 162H232" />
        <path d="M96 113q14-16 28 0" class="thin" />
        <g class="beam">
          <path d="M78 74H146" />
          <path d="M140 70l6 4-6 4" />
        </g>
        {annotate && (
          <g class="dim">
            <text x="150" y="70">
              B₀
            </text>
            <text x="38" y="14">
              1.5T · 3T
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'pet' && (
      <g>
        <rect x="44" y="14" width="152" height="152" rx="22" />
        <circle cx="120" cy="90" r="40" />
        <g class="spin-slow">
          {bloques.map((deg) => (
            <rect x="171" y="86" width="9" height="8" transform={`rotate(${deg} 120 90)`} class="thin" />
          ))}
        </g>
        <g class="beam">
          <path d="M70.6 63.1L169.4 116.9" />
          <circle cx="132" cy="96.5" r="2.2" fill="currentColor" />
        </g>
        <rect x="94" y="106" width="52" height="6" rx="1" />
        <path d="M60 166V170H180V166M10 170H230" />
        {annotate && (
          <g class="dim">
            <text x="140" y="110">
              511 keV
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'eco' && (
      <g>
        <rect x="62" y="20" width="76" height="50" rx="2" />
        <path class="beam" d="M100 28L84 60A30 30 0 0 0 116 60Z" />
        <path d="M100 70V88" />
        <path d="M50 96H150L142 88H58Z" />
        <rect x="58" y="96" width="84" height="40" />
        <path d="M70 108H130M70 116H112" class="thin" />
        <rect x="92" y="136" width="16" height="16" />
        <rect x="64" y="152" width="72" height="5" />
        <circle cx="72" cy="162" r="4" />
        <circle cx="128" cy="162" r="4" />
        <path d="M142 104C176 104 178 60 198 58" class="thin" />
        <path d="M194 42h12l3 22h-18z" />
        <g class="beam">
          <path d="M186 76q14 8 28 0" />
          <path d="M182 86q18 11 36 0" />
          <path d="M178 96q22 14 44 0" />
        </g>
        {annotate && (
          <g class="dim">
            <text x="178" y="118">
              TRANSDUCTOR
            </text>
          </g>
        )}
      </g>
    )
  }

  {
    id === 'dmo' && (
      <g>
        <rect x="16" y="104" width="208" height="8" rx="1" />
        <rect x="22" y="112" width="196" height="44" />
        <path d="M14 162H226M28 156V162M212 156V162" />
        <path d="M196 104V36H134" />
        <path d="M204 104V44H134" class="thin" />
        <rect x="102" y="32" width="34" height="16" rx="1" />
        <rect x="108" y="122" width="22" height="9" rx="1" />
        <path class="beam" d="M115 122L113 48M123 122L125 48" />
        <path d="M44 96h34l-10 0" class="thin" />
        {annotate && (
          <g class="dim">
            <path d="M44 92H90M44 92l5-3M44 92l5 3M90 92l-5-3M90 92l-5 3" />
            <text x="48" y="84">
              BARRIDO
            </text>
          </g>
        )}
      </g>
    )
  }
</svg>

<style>
  .schematic {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .schematic :global(.thin) {
    stroke-width: 0.75;
    opacity: 0.7;
  }
  .schematic :global(.beam) {
    stroke: var(--c-accent);
    stroke-dasharray: 3 3;
    animation: haz 0.8s linear infinite;
  }
  @keyframes haz {
    to {
      stroke-dashoffset: -6;
    }
  }
  .schematic.live :global(.spin) {
    animation: giro 28s linear infinite;
  }
  .schematic.live :global(.spin-slow) {
    animation: giro 70s linear infinite;
  }
  @keyframes giro {
    to {
      transform: rotate(360deg);
    }
  }
  .schematic :global(.beam.axis) {
    stroke-dasharray: 1 3;
    opacity: 0.7;
  }
  .schematic :global(.dim) {
    stroke-width: 0.7;
    opacity: 0.55;
  }
  .schematic :global(.dim text),
  .schematic :global(text) {
    stroke: none;
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 7px;
    letter-spacing: 0.06em;
  }
  .schematic :global(.spin),
  .schematic :global(.spin-slow) {
    transform-box: view-box;
    transform-origin: 120px 90px;
  }
</style>
