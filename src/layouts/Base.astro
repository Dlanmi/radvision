---
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource-variable/inter-tight';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import Glosa from '../components/Glosa.astro';
import { proyecto } from '../data/proyecto';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Catálogo técnico de 32 fichas de equipos de imagen diagnóstica con inteligencia artificial autorizada por la FDA: 8 modalidades, 4 fabricantes, con perspectiva de física médica e ingeniería. Proyecto SENA.',
} = Astro.props;

const fullTitle = title ? `${title} — ${proyecto.sitio}` : `${proyecto.sitio} — ${proyecto.sitioLargo}`;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f0eb" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('tema');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          d.dataset.theme = t;
          if (t === 'dark') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0f110f');
        } catch (e) {}
        // Si las animaciones no cargan, se muestra el contenido igual.
        setTimeout(function () {
          d.classList.add('motion-ready');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <a href="#contenido" class="label sr-only z-[70] bg-ink px-4 py-3 text-bg focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Search />
    <Glosa />
    <button type="button" class="volver" data-volver aria-label="Volver arriba" hidden>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" /></svg>
    </button>
    <script>
      import '../scripts/ui';
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .volver {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 45;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--c-ink);
    color: var(--c-bg);
    border: 1px solid var(--c-ink);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.45);
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.25s,
      translate 0.25s,
      background-color 0.2s;
  }
  .volver.visible {
    opacity: 1;
    translate: 0 0;
  }
  .volver[hidden] {
    display: none;
  }
  .volver:hover {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #0d0f0e;
  }
  .volver svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .js:not(.motion-ready) [data-reveal],
  .js:not(.motion-ready) [data-split] {
    opacity: 0;
  }
  .split-line {
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
</style>
